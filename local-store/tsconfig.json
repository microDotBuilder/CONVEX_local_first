{
  "include": ["**/*.ts", "**/*.js", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "test"],
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "outDir": "./dist",
    "noEmit": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "customConditions": ["convex-internal-types"]
  }
}
